# Copy these names into GitHub → Settings → Secrets and variables → Actions → Variables.
# Missing or false = off. Values other than true/false/yes/no/on/off/1/0 fail the run,
# even when IOS_RELEASE_AUTOMATION is off.

# --- iOS (v* tags; .github/workflows/ios-release.yml) ---
# Master switch: when off, no App Store operation runs (the GitHub Release is still created).
IOS_RELEASE_AUTOMATION=false
# Create the tag's App Store version in App Store Connect when it is missing (before
# the read-only check). Leaves an existing version alone; refuses when another version
# is still on its way to the store or the tag is not newer than every existing version.
# Tag runs only.
IOS_CREATE_VERSION=false
# Build, sign and upload the binary to App Store Connect, then wait until it is processed.
IOS_UPLOAD_BUILD=false
# Name, subtitle, privacy URL, description, keywords, promotional text, marketing/support URLs
# (store/metadata/ios/<locale>/).
IOS_UPLOAD_LISTING=false
# What's New text (store/metadata/ios/<locale>/whats_new.txt).
IOS_UPLOAD_WHATS_NEW=false
# iPhone 6.7" and iPad 12.9" screenshots (store/metadata/screenshots/ios/6.7 and store/metadata/screenshots/ios/12.9).
IOS_UPLOAD_SCREENSHOTS=false
# Select this run's processed build and submit the version for App Review (needs IOS_UPLOAD_BUILD).
IOS_SUBMIT_REVIEW=false
# true = release automatically after approval; false = you release it by hand (needs IOS_SUBMIT_REVIEW).
IOS_PUBLIC_RELEASE=false
# Build readiness polling (defaults shown): poll interval 10–600 s; total wait 10–300 min,
# counted from the start of the upload.
IOS_BUILD_POLL_SECONDS=30
IOS_BUILD_WAIT_MINUTES=120
